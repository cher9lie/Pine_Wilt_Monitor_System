# ============================================================
# Pine Wilt Monitor System - Environment Variables Template
# Copy this file to .env and fill in your actual values
# WARNING: Do NOT use Chinese characters in any value!
# ============================================================

# PostgreSQL + PostGIS
POSTGRES_DB=pine_wilt_db
POSTGRES_USER=pine_admin
POSTGRES_PASSWORD=YourStrongPasswordHere123!
DATABASE_URL=postgresql://pine_admin:YourStrongPasswordHere123!@postgres:5432/pine_wilt_db

# Redis
REDIS_PASSWORD=YourRedisPassword456!
REDIS_URL=redis://:YourRedisPassword456!@redis:6379

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_64_char_random_hex_string_here_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex_string_openssl_rand_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO Object Storage
MINIO_ROOT_USER=pine_minio_admin
MINIO_ROOT_PASSWORD=YourMinioPassword789!
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=pine_minio_admin
MINIO_SECRET_KEY=YourMinioPassword789!
MINIO_BUCKET=pine-wilt-system

# InfluxDB (IoT time-series)
INFLUXDB_USER=pine_influx
INFLUXDB_PASSWORD=YourInfluxPassword012!
INFLUXDB_TOKEN=your-influx-admin-token-here
INFLUXDB_ORG=pine-wilt
INFLUXDB_BUCKET=iot-sensors
INFLUXDB_URL=http://influxdb:8086

# AI Inference Service
AI_SERVICE_URL=http://ai_service:8000
MODEL_PATH=/app/models/yolov8_pine_best.onnx
INFER_CONFIDENCE_THRESHOLD=0.5

# Node.js Backend
NODE_ENV=production
PORT=3000
# CORS_ORIGIN: Use * to allow all origins, or your actual domain
# Examples: *  or  http://monitor.example.com  or  https://your-domain.com
# MUST NOT contain Chinese characters or special unicode!
CORS_ORIGIN=*

# EMQX MQTT
EMQX_NODE__NAME=emqx@pine_emqx
