# ============================================================
# 「松海护航」环境变量模板
# 复制此文件为 .env 并填写真实值
# ============================================================

# PostgreSQL
POSTGRES_PASSWORD=your_strong_password_here

# Redis
REDIS_PASSWORD=your_redis_password_here

# MinIO
MINIO_ROOT_USER=pine_admin
MINIO_ROOT_PASSWORD=your_minio_password_here

# JWT（使用 openssl rand -hex 64 生成）
JWT_SECRET=your_jwt_secret_64_chars_minimum_replace_this
JWT_REFRESH_SECRET=your_refresh_secret_64_chars_minimum_replace_this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# InfluxDB
INFLUXDB_USER=pine_influx
INFLUXDB_PASSWORD=your_influxdb_password
INFLUXDB_TOKEN=your_influxdb_token_replace_this
INFLUXDB_ORG=pine-wilt
INFLUXDB_BUCKET=iot-sensors

# AI 服务
AI_SERVICE_URL=http://localhost:8000
MODEL_PATH=/app/models/yolov8_pine_best.onnx
INFER_CONFIDENCE_THRESHOLD=0.5

# Node.js 后端
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://pine_user:your_strong_password_here@localhost:5432/pine_wilt_db
REDIS_URL=redis://:your_redis_password_here@localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=pine_admin
MINIO_SECRET_KEY=your_minio_password_here
MINIO_BUCKET=pine-wilt-system

# CORS（开发环境）
CORS_ORIGIN=http://localhost:5173
